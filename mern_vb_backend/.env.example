# Copy to .env and fill in real values. Never commit .env itself.
#
# MONGODB_URI: point this at the Atlas dev/staging cluster, never at
# production. Production is a private Coolify Mongo instance, only reachable
# from inside the Coolify Docker network (see CLAUDE.md's Database section
# and docs/plan_db_cutover_and_grace_migration.md). Every script in scripts/
# is written and tested against Atlas; scripts/utils/productionGuard.js
# refuses to run a write script if this resolves to production.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/mern_vb_app?appName=<app-name>

PORT=5000

JWT_SECRET=

# Clerk (Development instance — pk_test_/sk_test_ — never the Production
# instance's live keys, locally)
CLERK_SECRET_KEY=sk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_WEBHOOK_SECRET=

INVITE_JWT_SECRET=

FRONTEND_URL=http://localhost:5173

SUPER_ADMIN_CLERK_ID=
SUPER_ADMIN_EMAIL=

RESEND_API_KEY=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

ADMIN_EMAIL=
